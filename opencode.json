{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/anthropic/claude-haiku-5.5",
  "small_model": "openrouter/openai/gpt-5-nano",
  "enabled_providers": ["openrouter"],
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "share": "disabled",
  "autoupdate": false
}
